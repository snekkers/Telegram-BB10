<?xml version="1.0" encoding="UTF-8"?>
<qnx xmlns="http://www.qnx.com/schemas/application/1.0">
    <id>org.example.berrygram</id>
    <name>Telegram</name>
    <versionNumber>0.17.0</versionNumber>
    <buildId>23</buildId>
    <description>Telegram client for BlackBerry Classic.</description>
    <author>Berrygram Developer</author>

    <icon><image>assets/icon.png</image></icon>

    <initialWindow>
        <aspectRatio>portrait</aspectRatio>
        <autoOrients>false</autoOrients>
        <systemChrome>none</systemChrome>
    </initialWindow>

    <configuration name="Simulator-Debug">
        <platformArchitecture>x86</platformArchitecture>
        <asset path="build/simulator/bin/berrygram" entry="true" type="Qnx/Elf">berrygram</asset>
    </configuration>
    <configuration name="Device-Debug">
        <platformArchitecture>armle-v7</platformArchitecture>
        <asset path="build/device/bin/berrygram" entry="true" type="Qnx/Elf">berrygram</asset>
        <asset path="build/device/telegram-runtime/bin/berrygram-tdjson" type="Qnx/Elf">telegram/bin/berrygram-tdjson</asset>
        <asset path="build/device/telegram-runtime/lib">telegram/lib</asset>
        <asset path="build/device/telegram-runtime/licenses">telegram/licenses</asset>
        <asset path="build/device/telegram-runtime/runtime-manifest.json">telegram/runtime-manifest.json</asset>
    </configuration>

    <asset path="assets">assets</asset>
    <permission system="true">run_native</permission>
    <permission>access_internet</permission>
    <permission>access_shared</permission>
    <permission>record_audio</permission>
    <permission>post_notification</permission>
    <permission>run_when_backgrounded</permission>
    <env var="LD_LIBRARY_PATH" value="app/native/lib:/usr/lib/qt4/lib"/>
</qnx>
